rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User documents, progress, and communication subcollections: Students can only access their own user folder
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /progress/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /communicationSessions/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public competitive leaderboard: Authenticated students can read standings; students can only update their own ranking doc
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default rule: Lock down all other collections until specific rules are required
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
